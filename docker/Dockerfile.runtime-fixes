# Derived image: runtime stabilisation layer over the deployed -gtk base.
#
#   DOCKER_BUILDKIT=1 docker build -f docker/Dockerfile.runtime-fixes \
#       --build-arg BASE=hermes-agent:merged-bff18e6ff0-gtk \
#       -t hermes-agent:merged-bff18e6ff0-gtk-runtimefix .
#
# Ships two fixes that cannot reach the runtime through the platform release
# pipeline (it only covers /opt/data/scripts|plugins|tests|docs):
#  1. agent/agent_runtime_helpers.py: bake the terminal-alias repair branch
#     (models calling "shell"/"bash"/... were rejected 3/3 as unknown tools by
#     turn validation in per-profile kanban workers -- t_58ff9db1 class, where
#     the user-layer tool-name-aliases plugin is not loadable).
#  2. vendor/pyyaml: the sealed venv ships hermes_yaml but no `yaml` module,
#     while runtime scripts and repo code legitimately `import yaml` and use the
#     full PyYAML API (yaml.SafeDumper in hermes-agent utils.py, ...). Install
#     the pure-Python package for whatever interpreter the image exposes, so the
#     answer never depends on which python3 PATH resolves to.
ARG BASE=hermes-agent:merged-bff18e6ff0-gtk
FROM ${BASE}
COPY agent/agent_runtime_helpers.py /opt/hermes/agent/agent_runtime_helpers.py
COPY vendor/pyyaml/yaml /tmp/pyyaml/yaml
RUN set -eu; \
    installed=0; \
    for d in /opt/hermes/.venv/lib/python3.*/site-packages \
             /opt/hermes/tools/python-*/lib/python3.*/site-packages \
             /usr/lib/python3/dist-packages; do \
        [ -d "$d" ] || continue; \
        rm -rf "$d/yaml"; \
        cp -r /tmp/pyyaml/yaml "$d/yaml"; \
        installed=$((installed + 1)); \
        echo "pyyaml -> $d"; \
    done; \
    [ "$installed" -gt 0 ] || { echo "no site-packages found for pyyaml" >&2; exit 1; }; \
    rm -rf /tmp/pyyaml
