# Derived image: runtime stabilisation layer over the deployed -gtk base.
#
#   DOCKER_BUILDKIT=1 docker build -f docker/Dockerfile.runtime-fixes \
#       --build-arg BASE=hermes-agent:merged-bff18e6ff0-gtk \
#       -t hermes-agent:merged-bff18e6ff0-gtk-runtimefix .
#
# Ships two fixes that cannot reach the runtime through the platform release
# pipeline (it only covers /opt/data/scripts|plugins|tests|docs):
#  1. agent/agent_runtime_helpers.py: bake the terminal-alias repair branch
#     (models calling "shell"/"bash"/... were rejected 3/3 as unknown tools by
#     turn validation in per-profile kanban workers -- t_58ff9db1 class, where
#     the user-layer tool-name-aliases plugin is not loadable).
#  2. vendor/pyyaml: the sealed venv ships hermes_yaml but no `yaml` module,
#     while runtime scripts and repo code legitimately `import yaml` and use the
#     full PyYAML API (yaml.SafeDumper in hermes-agent utils.py, ...). Install
#     the pure-Python package for whatever interpreter the image exposes, so the
#     answer never depends on which python3 PATH resolves to.
#  3. hermes_cli/kanban_db.py: trashing a *running* card now terminates its
#     worker (PR #30, merge 46593ada33) instead of only nulling worker_pid, which
#     left an orphan process burning tokens against a card nothing tracks.
#  4. hermes_cli/kanban_db_dispatch.py: worker argv carries -P so the harness
#     never imports hermes from the task workspace (workers run with
#     TERMINAL_CWD = a checkout of this repo, and the cwd wins for `-m`).
#  5. hermes_cli/kanban_db_dispatch.py: a worker whose exit status is
#     unobservable (claimed by a previous dispatcher process) is requeued as
#     `lost_status` instead of being booked as a crash, with a bounded cap.
#  6. cron/scheduler.py: DRIFT_SKIP_MARKER narrowed from the bare word
#     "WARNING" to "[drift_skip:silent]" — the consumer suppresses a failed
#     run's delivery when its error text contains the marker, so the generic
#     word silently swallowed unrelated failures.
#  7. Merged factory PRs #33/#34/#35 (main c083035e41c):
#     - hermes_cli/kanban_db.py + kanban_db_dispatch.py: _end_run now closes every
#       row still marked `running`, not only the one current_run_id points at, so an
#       orphaned run can no longer be read as a live attempt (the phantom multi-hour
#       rows a worker crash leaves behind).
#     - gateway/kanban_watchers_common.py: dispatcher-lock reads are BOM-tolerant
#       (utf-8-sig) while writes stay BOM-free — Windows tooling that touches the
#       lock file no longer makes the lease unreadable.
#     - agent/chat_completion_helpers.py + agent/turn_recovery.py + new
#       agent/fallback_rate_limit_sidecar.py: a model the provider just rate-limited
#       is skipped by the fallback walk instead of being re-selected immediately;
#       cooldown state lives at $HERMES_HOME/.kanban_rate_limit.json (writable state,
#       never the read-only release mounts).
#  7. agent/kanban_stop.py + agent/prompt_builder.py: the kanban worker
#     terminal-tool protocol was too weak — a worker could end its session with a
#     plain-text message and no terminal board call, recorded as a "protocol
#     violation (clean exit with the card still running)", burning retries and
#     redoing the work. The stop-nudge budget is raised (2 -> 4) and KANBAN_GUIDANCE
#     now carries an explicit MANDATORY terminal-action section ("your final
#     response MUST be a kanban_complete / kanban_request_review /
#     kanban_request_changes / kanban_block tool call; a plain-text ending is a
#     protocol violation").
ARG BASE=hermes-agent:merged-bff18e6ff0-gtk
FROM ${BASE}
COPY agent/agent_runtime_helpers.py /opt/hermes/agent/agent_runtime_helpers.py
COPY hermes_cli/kanban_db.py /opt/hermes/hermes_cli/kanban_db.py
COPY hermes_cli/kanban_db_dispatch.py /opt/hermes/hermes_cli/kanban_db_dispatch.py
COPY cron/scheduler.py /opt/hermes/cron/scheduler.py
COPY gateway/kanban_watchers_common.py /opt/hermes/gateway/kanban_watchers_common.py
COPY agent/chat_completion_helpers.py /opt/hermes/agent/chat_completion_helpers.py
COPY agent/turn_recovery.py /opt/hermes/agent/turn_recovery.py
COPY agent/fallback_rate_limit_sidecar.py /opt/hermes/agent/fallback_rate_limit_sidecar.py
COPY agent/kanban_stop.py /opt/hermes/agent/kanban_stop.py
COPY agent/prompt_builder.py /opt/hermes/agent/prompt_builder.py
COPY vendor/pyyaml/yaml /tmp/pyyaml/yaml
RUN set -eu; \
    installed=0; \
    for d in /opt/hermes/.venv/lib/python3.*/site-packages \
             /opt/hermes/tools/python-*/lib/python3.*/site-packages \
             /usr/lib/python3/dist-packages; do \
        [ -d "$d" ] || continue; \
        rm -rf "$d/yaml"; \
        cp -r /tmp/pyyaml/yaml "$d/yaml"; \
        installed=$((installed + 1)); \
        echo "pyyaml -> $d"; \
    done; \
    [ "$installed" -gt 0 ] || { echo "no site-packages found for pyyaml" >&2; exit 1; }; \
    rm -rf /tmp/pyyaml
